<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SDK Manager"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>
    <EditText android:id="@+id/et_compile" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="compileSdk (34)" android:inputType="number"/>
    <EditText android:id="@+id/et_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="targetSdk (34)" android:inputType="number" android:layout_marginTop="12dp"/>
    <EditText android:id="@+id/et_min" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="minSdk (21)" android:inputType="number" android:layout_marginTop="12dp"/>
    <Button android:id="@+id/btn_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE SDK" android:layout_marginTop="24dp"/>
</LinearLayout>
